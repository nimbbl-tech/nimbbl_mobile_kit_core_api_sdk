# Maven Central (Central Portal) and GPG signing
# Copy to .env and set values. Never commit .env (it is in .gitignore).
#
# Central Portal user token (required for deploy to staging):
# Create at https://central.sonatype.com/usertoken → Generate User Token.
# Use the token username and password (separate from your Sonatype account login).
centralPortalUsername=
centralPortalPassword=
#
# GPG signing (required for Maven Central)
# keyId = last 8 chars of your key id (gpg --list-keys)
# secretKeyRingFile = path to signing-key.gpg (binary export: gpg --export-secret-keys <KEY_ID> > signing-key.gpg)
signing.keyId=
signing.password=
signing.secretKeyRingFile=
